<Project>

  <!-- Central package management: direct PackageReference versions live here and nowhere else.
       Transitive resolution is not locked (no packages.lock.json, see README).
       Packages of one family move together: Microsoft.CodeAnalysis.*, ModelContextProtocol*,
       Microsoft.Extensions.*. tests/fixtures and spikes opt out (see their Directory.Packages.props). -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test material only (GenerationTriggers fixture): pinned for the trigger rule table,
         see spikes/s9-generation-triggers/CONCLUSIONS.md. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.402" />
    <!-- Stays on 1.9.1. From 1.10 on, the package fails the build with MSBL001 because
         Microsoft.CodeAnalysis.Workspaces.MSBuild brings Microsoft.Build.Framework in as a runtime asset.
         Excluding it changes what the tool package ships; tracked in #498. -->
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.9.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
