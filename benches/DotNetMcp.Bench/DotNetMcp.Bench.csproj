<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>DotNetMcp.Bench</RootNamespace>
    <Description>Product-facing performance harness for dotnet-mcp (MCP tool surface).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetMcp.Server\DotNetMcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tests\fixtures\**\*"
          Exclude="..\..\tests\fixtures\**\bin\**;\..\..\tests\fixtures\**\obj\**;\..\..\tests\fixtures\.gitignore"
          Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
