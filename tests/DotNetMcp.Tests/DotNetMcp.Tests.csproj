<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GenerationTriggers fixture runs the MVVM Toolkit generators under
         MSBuildWorkspace. GeneratePathProperty feeds the DLL copies below. -->
    <PackageReference Include="CommunityToolkit.Mvvm" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetMcp.Server\DotNetMcp.Server.csproj" />
    <ProjectReference Include="..\..\benches\DotNetMcp.Bench\DotNetMcp.Bench.csproj" />
    <ProjectReference Include="..\..\src\DotNetMcp.FSharp\DotNetMcp.FSharp.csproj" />
    <ProjectReference Include="..\fixtures\CustomGenerator\CustomGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*"
          Exclude="..\fixtures\**\bin\**;..\fixtures\**\obj\**;..\fixtures\.gitignore"
          Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Fixture copies land without obj/, so NuGet package/analyzer resolution cannot
         run there. The GenerationTriggers csproj falls back to these side-by-side DLLs
         (Reference + Analyzer items) when they exist next to it. -->
    <None Include="$(PkgCommunityToolkit_Mvvm)\lib\net8.0\CommunityToolkit.Mvvm.dll"
          Link="fixtures\GenerationTriggers\CommunityToolkit.Mvvm.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgCommunityToolkit_Mvvm)\analyzers\dotnet\roslyn5.0\cs\CommunityToolkit.Mvvm.SourceGenerators.dll"
          Link="fixtures\GenerationTriggers\CommunityToolkit.Mvvm.SourceGenerators.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
